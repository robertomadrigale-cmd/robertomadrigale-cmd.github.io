rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada persona solo lee y escribe su propio progreso.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Clases del modo maestro.
    match /groups/{code} {
      // Cualquier persona con sesión puede comprobar que un código existe para unirse.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      match /members/{uid} {
        // El alumno escribe su propio resumen; el maestro dueño de la clase lo puede leer y quitar.
        allow read: if request.auth != null && (request.auth.uid == uid
          || get(/databases/$(database)/documents/groups/$(code)).data.owner == request.auth.uid);
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid
          || get(/databases/$(database)/documents/groups/$(code)).data.owner == request.auth.uid);
      }
    }
  }
}
